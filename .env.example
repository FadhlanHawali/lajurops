# Copy to .env and adjust. docker compose reads .env automatically.
LAJUROPS_DB_PASSWORD=planner
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret of the confidential "lajurops-service" client used for user management
LAJUROPS_SERVICE_CLIENT_SECRET=dev-admin-secret-change-me

# Public URL of Keycloak exactly as the browser reaches it. When people open
# LajurOps from other machines, use the server's hostname or IP, e.g.
# http://planner.office.lan:8081 (not localhost).
PUBLIC_KEYCLOAK_URL=http://localhost:8081

# debug, info, warn or error
LOG_LEVEL=info

# What a non-admin may do in a workspace nobody gave them a role in: viewer or none
DEFAULT_WORKSPACE_ROLE=viewer

# HTTPS to Keycloak with an internal CA ("x509: certificate signed by unknown
# authority"): trust the CA (path inside the container, see README) ...
#KEYCLOAK_CA_CERT=/certs/company-ca.pem
# ... or skip verification entirely (insecure, last resort)
#KEYCLOAK_TLS_SKIP_VERIFY=true
