# Copy to .env and adjust. docker compose reads .env automatically.
PLANNER_DB_PASSWORD=planner
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret of the confidential "open-planner-admin" client used for user management
PLANNER_ADMIN_CLIENT_SECRET=dev-admin-secret-change-me

# Public URL of Keycloak as seen by the browser
PUBLIC_KEYCLOAK_URL=http://localhost:8081
