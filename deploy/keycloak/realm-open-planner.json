{
  "realm": "open-planner",
  "displayName": "Open Planner",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "clients": [
    {
      "clientId": "open-planner",
      "name": "Open Planner",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:8080",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "open-planner-admin",
      "name": "Open Planner user management",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PLANNER_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Anderson",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-open-planner",
        "planner-admin"
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Brown",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-open-planner"
      ]
    },
    {
      "username": "service-account-open-planner-admin",
      "enabled": true,
      "serviceAccountClientId": "open-planner-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "planner-admin",
        "description": "Can manage Open Planner users"
      }
    ]
  }
}
